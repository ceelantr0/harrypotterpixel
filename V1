  </div>

  <script>
    // Game Engine State Variables
    const canvas = document.getElementById('gameCanvas');
    const ctx = canvas.getContext('2d');

    const V_WIDTH = 384;
    const V_HEIGHT = 216;

    let isPlaying = false;
    let isPaused = false;
    let currentLevel = 1;
    let score = 0;
    let chosenChar = 'harry'; // 'harry', 'hermione', 'ron'
    let voldemortCritHits = 0; // Needs 5 critical hits on Voldemort
    let levelState = 'MINORS'; // 'MINORS' or 'BOSS' or 'FINAL_DUEL'
    let levelMinorKills = 0;
    const REQUIRED_KILLS_FOR_BOSS = 8;

    let highScore = parseInt(localStorage.getItem('hogwarts_pixel_highscore') || '0');
    document.getElementById('startHighScore').innerText = highScore;

    const keys = { left: false, right: false, jump: false, cast: false, special: false };

    class SoundFX {
      constructor() {
        this.ctx = null;
        this.enabled = true;
      }

      init() {
        if (!this.ctx) {
          this.ctx = new (window.AudioContext || window.webkitAudioContext)();
        }
      }

      playSpell() {
        if (!this.enabled || !this.ctx) return;
        const osc = this.ctx.createOscillator();
        const gain = this.ctx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(600, this.ctx.currentTime);
        osc.frequency.exponentialRampToValueAtTime(1200, this.ctx.currentTime + 0.12);
        gain.gain.setValueAtTime(0.15, this.ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.01, this.ctx.currentTime + 0.12);
        osc.connect(gain);
        gain.connect(this.ctx.destination);
        osc.start();
        osc.stop(this.ctx.currentTime + 0.12);
      }

      playCritHit() {
        if (!this.enabled || !this.ctx) return;
        const osc = this.ctx.createOscillator();
        const gain = this.ctx.createGain();
        osc.type = 'triangle';
        osc.frequency.setValueAtTime(300, this.ctx.currentTime);
        osc.frequency.exponentialRampToValueAtTime(900, this.ctx.currentTime + 0.2);
        gain.gain.setValueAtTime(0.3, this.ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.01, this.ctx.currentTime + 0.2);
        osc.connect(gain);
        gain.connect(this.ctx.destination);
        osc.start();
        osc.stop(this.ctx.currentTime + 0.2);
      }

      playJump() {
        if (!this.enabled || !this.ctx) return;
        const osc = this.ctx.createOscillator();
        const gain = this.ctx.createGain();
        osc.type = 'square';
        osc.frequency.setValueAtTime(250, this.ctx.currentTime);
        osc.frequency.linearRampToValueAtTime(500, this.ctx.currentTime + 0.1);
        gain.gain.setValueAtTime(0.1, this.ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.01, this.ctx.currentTime + 0.1);
        osc.connect(gain);
        gain.connect(this.ctx.destination);
        osc.start();
        osc.stop(this.ctx.currentTime + 0.1);
      }

      playHurt() {
        if (!this.enabled || !this.ctx) return;
        const osc = this.ctx.createOscillator();
        const gain = this.ctx.createGain();
        osc.type = 'sawtooth';
        osc.frequency.setValueAtTime(180, this.ctx.currentTime);
        osc.frequency.linearRampToValueAtTime(60, this.ctx.currentTime + 0.2);
        gain.gain.setValueAtTime(0.25, this.ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.01, this.ctx.currentTime + 0.2);
        osc.connect(gain);
        gain.connect(this.ctx.destination);
        osc.start();
        osc.stop(this.ctx.currentTime + 0.2);
      }

      playBossDefeat() {
        if (!this.enabled || !this.ctx) return;
        const notes = [400, 523, 659, 783, 1046];
        notes.forEach((freq, i) => {
          const osc = this.ctx.createOscillator();
          const gain = this.ctx.createGain();
          osc.type = 'triangle';
          osc.frequency.setValueAtTime(freq, this.ctx.currentTime + i * 0.08);
          gain.gain.setValueAtTime(0.2, this.ctx.currentTime + i * 0.08);
          gain.gain.exponentialRampToValueAtTime(0.01, this.ctx.currentTime + i * 0.08 + 0.15);
          osc.connect(gain);
          gain.connect(this.ctx.destination);
          osc.start(this.ctx.currentTime + i * 0.08);
          osc.stop(this.ctx.currentTime + i * 0.08 + 0.15);
        });
      }
    }

    const sound = new SoundFX();

    // --- LEVEL DEFINITIONS AND SPECS ---
    const LEVEL_CONFIGS = {
      1: {
        name: "Dungeon Classroom",
        bgTop: "#0f081c",
        bgBottom: "#2d1b4e",
        platformColor: "#583885",
        minorEnemyType: "spider",
        minorEnemyName: "Spiders",
        bossType: "quirrell",
        bossName: "Professor Quirrell",
        bossHp: 100
      },
      2: {
        name: "Chamber of Secrets",
        bgTop: "#041512",
        bgBottom: "#0b3c32",
        platformColor: "#186353",
        minorEnemyType: "ghost",
        minorEnemyName: "Female Student Ghosts",
        bossType: "basilisk",
        bossName: "The Basilisk",
        bossHp: 140
      },
      3: {
        name: "Forbidden Forest",
        bgTop: "#08101e",
        bgBottom: "#152642",
        platformColor: "#22477a",
        minorEnemyType: "dementor",
        minorEnemyName: "Dementors",
        bossType: "werewolf",
        bossName: "Werewolf",
        bossHp: 180
      },
      4: {
        name: "Herbology Greenhouse",
        bgTop: "#171a06",
        bgBottom: "#3c4213",
        platformColor: "#5e6620",
        minorEnemyType: "mandrake",
        minorEnemyName: "Walking Mandrakes",
        bossType: "deathEater",
        bossName: "Death Eater",
        bossHp: 220
      },
      5: {
        name: "Grand Staircase",
        bgTop: "#23061f",
        bgBottom: "#521249",
        platformColor: "#852377",
        minorEnemyType: "poltergeist",
        minorEnemyName: "Poltergeists",
        bossType: "bellatrix",
        bossName: "Bellatrix Lestrange",
        bossHp: 260
      },
      6: {
        name: "Gringotts Vaults",
        bgTop: "#231805",
        bgBottom: "#543c10",
        platformColor: "#8f681f",
        minorEnemyType: "goblin",
        minorEnemyName: "Rogue Goblins",
        bossType: "horcrux",
        bossName: "The Horcrux Locket",
        bossHp: 300
      },
      7: {
        name: "Battlefield Courtyard",
        bgTop: "#2b0707",
        bgBottom: "#5e1515",
        platformColor: "#992929",
        minorEnemyType: "minorWerewolf",
        minorEnemyName: "Rogue Werewolves",
        bossType: "nagini",
        bossName: "Nagini",
        bossHp: 350
      },
      8: {
        name: "Great Hall - Final Duel",
        bgTop: "#120320",
        bgBottom: "#360d5c",
        platformColor: "#611db5",
        minorEnemyType: "none",
        minorEnemyName: "None",
        bossType: "voldemort",
        bossName: "Lord Voldemort",
        bossHp: 500 // Voldemort requires 5 critical hits!
      }
    };

    // Game Objects Lists
    let player;
    let platforms = [];
    let minorEnemies = [];
    let boss = null;
    let playerProjectiles = [];
    let enemyProjectiles = [];
    let particles = [];
    let floatingTexts = [];

    // --- PLAYER CLASS ---
    class WizardPlayer {
      constructor(charType) {
        this.charType = charType;
        this.w = 18;
        this.h = 24;
        this.x = 40;
        this.y = 140;
        this.vx = 0;
        this.vy = 0;
        this.grounded = false;
        this.facing = 1; // 1 = Right, -1 = Left
        this.maxHp = charType === 'harry' ? 120 : 100;
        this.hp = this.maxHp;
        this.castCooldown = 0;
        this.specialCooldown = 0; // Cooldown timer for character special attack
        this.invulnerableTimer = 0;

        // Character specific tuning
        this.speed = charType === 'hermione' ? 2.8 : 2.4;
        this.jumpPower = 6.2;
        this.spellColor = charType === 'harry' ? '#06b6d4' : (charType === 'hermione' ? '#f59e0b' : '#ef4444');
      }

      update() {
        // Horizontal Movement
        if (keys.left) {
          this.vx = -this.speed;
          this.facing = -1;
        } else if (keys.right) {
          this.vx = this.speed;
          this.facing = 1;
        } else {
          this.vx = 0;
        }

        // Jump
        if (keys.jump && this.grounded) {
          this.vy = -this.jumpPower;
          this.grounded = false;
          sound.playJump();
        }

        // Gravity
        this.vy += 0.32;
        if (this.vy > 7) this.vy = 7;

        // Apply movement
        this.x += this.vx;
        this.y += this.vy;

        // Platform Collisions
        this.grounded = false;
        platforms.forEach(p => {
          if (
            this.x + this.w > p.x &&
            this.x < p.x + p.w &&
            this.y + this.h >= p.y &&
            this.y + this.h <= p.y + p.h + this.vy &&
            this.vy >= 0
          ) {
            this.y = p.y - this.h;
            this.vy = 0;
            this.grounded = true;
          }
        });

        // Stage Boundaries
        if (this.x < 4) this.x = 4;
        if (this.x + this.w > V_WIDTH - 4) this.x = V_WIDTH - this.w - 4;
        if (this.y > V_HEIGHT + 30) {
          this.takeDamage(30);
          this.y = 100;
          this.x = 50;
        }

        if (this.castCooldown > 0) this.castCooldown--;
        if (this.specialCooldown > 0) this.specialCooldown--;
        if (this.invulnerableTimer > 0) this.invulnerableTimer--;

        // Attack Logic: Basic Spell vs Special Ability
        if (keys.cast && this.castCooldown <= 0) {
          this.castSpell();
        }
        if (keys.special && this.specialCooldown <= 0) {
          this.castSpecialAttack();
        }
      }

      castSpell() {
        const cooldownRate = this.charType === 'hermione' ? 12 : 18;
        this.castCooldown = cooldownRate;
        sound.playSpell();

        const pX = this.facing === 1 ? this.x + this.w : this.x - 8;
        const pY = this.y + 8;
        const pVx = this.facing * (this.charType === 'ron' ? 5 : 6);

        playerProjectiles.push({
          x: pX,
          y: pY,
          vx: pVx,
          vy: 0,
          w: 8,
          h: 6,
          color: this.spellColor,
          damage: this.charType === 'ron' ? 30 : 20,
          isCrit: Math.random() < (this.charType === 'harry' ? 0.35 : 0.20)
        });

        // Wand Flash Particle
        createSparkles(pX, pY, this.spellColor, 4);
      }

      castSpecialAttack() {
        this.specialCooldown = 180; // 3 second cooldown
        sound.playCritHit();

        const pX = this.facing === 1 ? this.x + this.w : this.x - 16;
        const pY = this.y + 4;

        if (this.charType === 'harry') {
          // Harry: Expecto Patronum Stag Blast (Massive piercing projectile)
          playerProjectiles.push({
            x: pX,
            y: pY - 4,
            vx: this.facing * 7,
            vy: 0,
            w: 18,
            h: 14,
            color: '#38bdf8',
            damage: 60,
            isCrit: true
          });
          triggerFloatingText(this.x, this.y - 10, 'EXPECTO PATRONUM!', '#38bdf8');
          createSparkles(this.x + 8, this.y + 8, '#38bdf8', 25);

        } else if (this.charType === 'hermione') {
          // Hermione: Triple Incendio Flame Burst (Spread attack)
          [-0.8, 0, 0.8].forEach(vY => {
            playerProjectiles.push({
              x: pX,
              y: pY,
              vx: this.facing * 6,
              vy: vY,
              w: 10,
              h: 8,
              color: '#f97316',
              damage: 40,
              isCrit: true
            });
          });
          triggerFloatingText(this.x, this.y - 10, 'INCENDIO BURST!', '#f97316');
          createSparkles(this.x + 8, this.y + 8, '#f97316', 20);

        } else if (this.charType === 'ron') {
          // Ron: Heavy Stupefy Shockwave (High damage blast)
          playerProjectiles.push({
            x: pX,
            y: pY - 2,
            vx: this.facing * 5,
            vy: 0,
            w: 22,
            h: 16,
            color: '#ef4444',
            damage: 75,
            isCrit: true
          });
          triggerFloatingText(this.x, this.y - 10, 'STUPEFY SHOCKWAVE!', '#ef4444');
          createSparkles(this.x + 8, this.y + 8, '#ef4444', 30);
        }
      }

      takeDamage(amount) {
        if (this.invulnerableTimer > 0) return;
        this.hp -= amount;
        this.invulnerableTimer = 40;
        sound.playHurt();
        createSparkles(this.x + this.w / 2, this.y + this.h / 2, '#ef4444', 10);
        if (this.hp <= 0) {
          this.hp = 0;
          gameOver();
        }
      }

      draw() {
        ctx.save();
        ctx.translate(Math.floor(this.x), Math.floor(this.y));

        if (this.invulnerableTimer % 4 >= 2) {
          ctx.globalAlpha = 0.5;
        }

        // Draw Pixel Wizard Body
        // Robe
        ctx.fillStyle = '#111827';
        ctx.fillRect(2, 6, 14, 18);

        // House Scarf / Accent
        ctx.fillStyle = this.charType === 'harry' ? '#800020' : (this.charType === 'hermione' ? '#1d4ed8' : '#d97724');
        ctx.fillRect(4, 8, 10, 4);

        // Face
        ctx.fillStyle = '#fde047';
        ctx.fillRect(4, 2, 10, 6);

        // Hair
        ctx.fillStyle = this.charType === 'ron' ? '#ea580c' : (this.charType === 'hermione' ? '#78350f' : '#1f2937');
        ctx.fillRect(3, 0, 12, 4);

        // Glasses for Harry
        if (this.charType === 'harry') {
          ctx.fillStyle = '#000000';
          ctx.fillRect(this.facing === 1 ? 8 : 4, 3, 3, 3);
          ctx.fillStyle = '#f59e0b'; // Lightning scar
          ctx.fillRect(7, 1, 2, 2);
        }

        // Wand
        ctx.fillStyle = '#854d0e';
        const wandX = this.facing === 1 ? 14 : -2;
        ctx.fillRect(wandX, 10, 6, 2);

        ctx.restore();
      }
    }

    function buildLevelPlatforms(levelNum) {
      platforms = [
        // Main Ground
        { x: 0, y: V_HEIGHT - 16, w: V_WIDTH, h: 16 },
        // Floating Platforms
        { x: 40, y: 140, w: 70, h: 8 },
        { x: 157, y: 110, w: 70, h: 8 },
        { x: 274, y: 140, w: 70, h: 8 },
        { x: 100, y: 70, w: 184, h: 8 }
      ];
    }

    class MinorEnemy {
      constructor(type) {
        this.type = type;
        this.w = 16;
        this.h = 16;
        this.x = Math.random() > 0.5 ? 10 : V_WIDTH - 26;
        this.y = Math.random() > 0.5 ? 50 : 120;
        this.vx = (Math.random() > 0.5 ? 1 : -1) * (0.8 + currentLevel * 0.15);
        this.hp = 25 + currentLevel * 10;
        this.animTimer = Math.random() * 100;
      }

      update() {
        this.x += this.vx;
        if (this.x < 10 || this.x > V_WIDTH - 26) this.vx *= -1;
        this.animTimer += 0.1;

        // Floating movement for Ghosts, Dementors, Poltergeists
        if (['ghost', 'dementor', 'poltergeist'].includes(this.type)) {
          this.y += Math.sin(this.animTimer) * 0.5;
        }
      }

      draw() {
        ctx.save();
        ctx.translate(Math.floor(this.x), Math.floor(this.y));

        switch (this.type) {
          case 'spider': // Level 1 Minor Enemy
            ctx.fillStyle = '#1e1b4b';
            ctx.fillRect(2, 4, 12, 10);
            ctx.fillStyle = '#ef4444'; // Red eyes
            ctx.fillRect(4, 6, 3, 2);
            ctx.fillRect(9, 6, 3, 2);
            // Legs
            ctx.fillStyle = '#0f172a';
            ctx.fillRect(-2, 2, 4, 2);
            ctx.fillRect(14, 2, 4, 2);
            ctx.fillRect(-2, 10, 4, 2);
            ctx.fillRect(14, 10, 4, 2);
            break;

          case 'ghost': // Level 2 Minor Enemy (Female Student Ghost)
            ctx.fillStyle = 'rgba(165, 243, 252, 0.75)';
            ctx.fillRect(2, 2, 12, 14);
            ctx.fillStyle = '#0891b2'; // Eyes/Mouth
            ctx.fillRect(4, 5, 3, 3);
            ctx.fillRect(9, 5, 3, 3);
            ctx.fillRect(6, 10, 4, 2);
            break;

          case 'dementor': // Level 3 Minor Enemy
            ctx.fillStyle = '#0f172a';
            ctx.fillRect(2, 0, 12, 16);
            ctx.fillStyle = '#334155';
            ctx.fillRect(4, 4, 8, 8);
            ctx.fillStyle = '#000000'; // Hollow mouth
            ctx.fillRect(6, 8, 4, 4);
            break;

          case 'mandrake': // Level 4 Minor Enemy
            ctx.fillStyle = '#854d0e';
            ctx.fillRect(4, 6, 8, 10);
            ctx.fillStyle = '#15803d'; // Leaves
            ctx.fillRect(2, 0, 12, 6);
            ctx.fillStyle = '#ef4444'; // Screaming mouth
            ctx.fillRect(6, 10, 4, 4);
            break;

          case 'poltergeist': // Level 5 Minor Enemy
            ctx.fillStyle = '#a855f7';
            ctx.fillRect(3, 3, 10, 12);
            ctx.fillStyle = '#fde047'; // Mischievous eyes
            ctx.fillRect(4, 5, 2, 2);
            ctx.fillRect(10, 5, 2, 2);
            break;

          case 'goblin': // Level 6 Minor Enemy
            ctx.fillStyle = '#15803d';
            ctx.fillRect(3, 4, 10, 12);
            ctx.fillStyle = '#78350f'; // Ear/Clothes
            ctx.fillRect(1, 4, 2, 4);
            ctx.fillRect(13, 4, 2, 4);
            ctx.fillStyle = '#fde047';
            ctx.fillRect(5, 6, 2, 2);
            break;

          case 'minorWerewolf': // Level 7 Minor Enemy
            ctx.fillStyle = '#451a03';
            ctx.fillRect(2, 2, 12, 14);
            ctx.fillStyle = '#f59e0b'; // Glowing eyes
            ctx.fillRect(4, 4, 2, 2);
            ctx.fillRect(10, 4, 2, 2);
            break;
        }

        ctx.restore();
      }
    }

    class BossEnemy {
      constructor(type) {
        this.type = type;
        this.w = 28;
        this.h = 32;
        this.x = V_WIDTH - 60;
        this.y = 80;
        this.vx = 1.2;
        this.vy = 0;
        this.maxHp = LEVEL_CONFIGS[currentLevel].bossHp;
        this.hp = this.maxHp;
        this.attackTimer = 0;
        this.teleportTimer = 0;
      }

      update() {
        this.attackTimer++;

        // Custom Boss Movements
        if (this.type === 'basilisk' || this.type === 'nagini') {
          // Slithering snake pattern
          this.x += Math.sin(this.attackTimer * 0.05) * 1.8;
          this.y = 135 + Math.sin(this.attackTimer * 0.1) * 15;
        } else if (this.type === 'horcrux') {
          // Levitating float
          this.y = 70 + Math.sin(this.attackTimer * 0.08) * 25;
          this.x += Math.cos(this.attackTimer * 0.04) * 1.5;
        } else if (this.type === 'voldemort') {
          // Voldemort Teleporting & Hovering
          this.teleportTimer++;
          if (this.teleportTimer > 120) {
            this.teleportTimer = 0;
            this.x = Math.random() * (V_WIDTH - 80) + 40;
            this.y = Math.random() * 80 + 40;
            createSparkles(this.x, this.y, '#22c55e', 20);
          }
        } else {
          // Standard Boss patrol
          this.x += this.vx;
          if (this.x < 150 || this.x > V_WIDTH - 40) this.vx *= -1;
        }

        // Boss Attack Actions
        if (this.attackTimer % 75 === 0) {
          this.launchBossAttack();
        }
      }

      launchBossAttack() {
        if (!player) return;
        const pX = player.x;
        const pY = player.y;
        const angle = Math.atan2(pY - (this.y + 16), pX - (this.x + 14));

        if (this.type === 'voldemort') {
          // Voldemort shoots lethal Avada Kedavra Green Beams
          enemyProjectiles.push({
            x: this.x + 14,
            y: this.y + 16,
            vx: Math.cos(angle) * 3.5,
            vy: Math.sin(angle) * 3.5,
            w: 12,
            h: 8,
            color: '#22c55e',
            damage: 25
          });
        } else if (this.type === 'bellatrix') {
          // Scatter Curses
          for (let i = -1; i <= 1; i++) {
            enemyProjectiles.push({
              x: this.x + 14,
              y: this.y + 16,
              vx: Math.cos(angle + i * 0.3) * 2.8,
              vy: Math.sin(angle + i * 0.3) * 2.8,
              w: 8,
              h: 8,
              color: '#a855f7',
              damage: 18
            });
          }
        } else {
          // Regular Boss Spell
          enemyProjectiles.push({
            x: this.x + 14,
            y: this.y + 16,
            vx: Math.cos(angle) * 2.5,
            vy: Math.sin(angle) * 2.5,
            w: 8,
            h: 8,
            color: '#ef4444',
            damage: 15
          });
        }
      }

      draw() {
        ctx.save();
        ctx.translate(Math.floor(this.x), Math.floor(this.y));

        if (this.type === 'quirrell') {
          ctx.fillStyle = '#6b21a8'; // Purple turban
          ctx.fillRect(4, 0, 20, 10);
          ctx.fillStyle = '#1e1b4b'; // Robes
          ctx.fillRect(4, 10, 20, 22);
          ctx.fillStyle = '#fde047';
          ctx.fillRect(6, 6, 16, 6);
        } else if (this.type === 'basilisk') {
          ctx.fillStyle = '#047857';
          ctx.fillRect(0, 4, 28, 24);
          ctx.fillStyle = '#ef4444'; // Glowing red eyes
          ctx.fillRect(4, 8, 4, 4);
          ctx.fillRect(16, 8, 4, 4);
          ctx.fillStyle = '#fde047'; // Fangs
          ctx.fillRect(8, 24, 3, 6);
          ctx.fillRect(17, 24, 3, 6);
        } else if (this.type === 'werewolf') {
          ctx.fillStyle = '#371b04';
          ctx.fillRect(2, 0, 24, 32);
          ctx.fillStyle = '#ef4444';
          ctx.fillRect(6, 6, 3, 3);
          ctx.fillRect(15, 6, 3, 3);
        } else if (this.type === 'deathEater') {
          ctx.fillStyle = '#000000';
          ctx.fillRect(2, 0, 24, 32);
          ctx.fillStyle = '#e2e8f0'; // Silver mask
          ctx.fillRect(6, 4, 16, 12);
          ctx.fillStyle = '#000000'; // Eye holes
          ctx.fillRect(8, 7, 3, 3);
          ctx.fillRect(17, 7, 3, 3);
        } else if (this.type === 'bellatrix') {
          ctx.fillStyle = '#18181b';
          ctx.fillRect(2, 0, 24, 32);
          ctx.fillStyle = '#71717a'; // Wild curly hair
          ctx.fillRect(0, -4, 28, 14);
          ctx.fillStyle = '#fde047';
          ctx.fillRect(6, 8, 4, 3);
          ctx.fillRect(16, 8, 4, 3);
        } else if (this.type === 'horcrux') {
          ctx.fillStyle = '#854d0e'; // Gold locket
          ctx.fillRect(4, 4, 20, 24);
          ctx.fillStyle = '#22c55e'; // Dark green magic core
          ctx.fillRect(8, 8, 12, 16);
        } else if (this.type === 'nagini') {
          ctx.fillStyle = '#14532d';
          ctx.fillRect(0, 6, 28, 20);
          ctx.fillStyle = '#ef4444';
          ctx.fillRect(4, 10, 4, 4);
        } else if (this.type === 'voldemort') {
          // Lord Voldemort
          ctx.fillStyle = '#0f172a'; // Black robes
          ctx.fillRect(2, 4, 24, 28);
          ctx.fillStyle = '#f1f5f9'; // Pale white skin
          ctx.fillRect(6, 0, 16, 12);
          ctx.fillStyle = '#dc2626'; // Slit red eyes
          ctx.fillRect(8, 4, 4, 2);
          ctx.fillRect(16, 4, 4, 2);
          ctx.fillStyle = '#94a3b8'; // Wand
          ctx.fillRect(-4, 16, 10, 2);
        }

        ctx.restore();
      }
    }

    function createSparkles(x, y, color, count = 8) {
      for (let i = 0; i < count; i++) {
        particles.push({
          x: x,
          y: y,
          vx: (Math.random() - 0.5) * 3,
          vy: (Math.random() - 0.5) * 3,
          color: color,
          life: 1.0,
          decay: 0.04 + Math.random() * 0.03
        });
      }
    }

    function triggerFloatingText(x, y, text, color = '#f59e0b') {
      floatingTexts.push({
        x: x,
        y: y,
        text: text,
        color: color,
        life: 1.0,
        vy: -0.6
      });
    }

    function drawHUD() {
      // Guard against drawing HUD before player is initialized
      if (!player) return;

      // Player HP Bar
      ctx.font = '6px "Press Start 2P"';
      ctx.fillStyle = '#ffffff';
      ctx.fillText(`${chosenChar.toUpperCase()} HP:`, 8, 12);

      const hpRatio = Math.max(0, player.hp / player.maxHp);
      ctx.fillStyle = '#1e293b';
      ctx.fillRect(60, 6, 80, 7);
      ctx.fillStyle = hpRatio > 0.4 ? '#22c55e' : '#ef4444';
      ctx.fillRect(60, 6, Math.floor(80 * hpRatio), 7);

      // Special Cooldown Meter
      ctx.fillStyle = '#f59e0b';
      ctx.fillText(`SPECIAL:`, 8, 35);
      const specRatio = 1 - Math.max(0, player.specialCooldown / 180);
      ctx.fillStyle = '#1e293b';
      ctx.fillRect(60, 29, 60, 6);
      ctx.fillStyle = specRatio >= 1 ? '#ef4444' : '#3b82f6';
      ctx.fillRect(60, 29, Math.floor(60 * specRatio), 6);
      if (specRatio >= 1) {
        ctx.fillStyle = '#ffffff';
        ctx.fillText(`READY`, 125, 35);
      }

      // Score
      ctx.fillStyle = '#f59e0b';
      ctx.fillText(`SCORE:${score}`, 150, 12);

      // Level Indicator
      ctx.fillStyle = '#06b6d4';
      if (currentLevel === 8) {
        ctx.fillText(`FINAL DUEL: VOLDEMORT`, 240, 12);
      } else {
        ctx.fillText(`LVL ${currentLevel}: ${LEVEL_CONFIGS[currentLevel].name.toUpperCase()}`, 240, 12);
      }

      // Boss or Level Progress Bar
      if (levelState === 'BOSS' && boss) {
        ctx.fillStyle = '#ef4444';
        ctx.fillText(`BOSS HP:`, 8, 23);
        const bossHpRatio = Math.max(0, boss.hp / boss.maxHp);
        ctx.fillStyle = '#1e293b';
        ctx.fillRect(60, 17, 120, 7);
        ctx.fillStyle = '#a855f7';
        ctx.fillRect(60, 17, Math.floor(120 * bossHpRatio), 7);
      } else if (levelState === 'FINAL_DUEL') {
        ctx.fillStyle = '#22c55e';
        ctx.fillText(`CRITICAL HITS NEEDED: ${5 - voldemortCritHits}/5`, 8, 23);
      } else {
        ctx.fillStyle = '#f59e0b';
        ctx.fillText(`FOES: ${levelMinorKills}/${REQUIRED_KILLS_FOR_BOSS}`, 8, 23);
      }
    }

    function renderBackground() {
      const cfg = LEVEL_CONFIGS[currentLevel];
      const grad = ctx.createLinearGradient(0, 0, 0, V_HEIGHT);
      grad.addColorStop(0, cfg.bgTop);
      grad.addColorStop(1, cfg.bgBottom);
      ctx.fillStyle = grad;
      ctx.fillRect(0, 0, V_WIDTH, V_HEIGHT);

      // Draw Hogwarts platforms
      ctx.fillStyle = cfg.platformColor;
      platforms.forEach(p => {
        ctx.fillRect(Math.floor(p.x), Math.floor(p.y), p.w, p.h);
        ctx.fillStyle = 'rgba(255,255,255,0.15)';
        ctx.fillRect(Math.floor(p.x), Math.floor(p.y), p.w, 2);
        ctx.fillStyle = cfg.platformColor;
      });
    }

    function updateGame() {
      if (!isPlaying || isPaused || !player) return;

      player.update();

      // Spawn Minor Enemies during MINORS phase
      if (levelState === 'MINORS') {
        if (minorEnemies.length < 3 && Math.random() < 0.03) {
          const enemyType = LEVEL_CONFIGS[currentLevel]?.minorEnemyType;
          if (enemyType && enemyType !== 'none') {
            minorEnemies.push(new MinorEnemy(enemyType));
          }
        }
      }

      // Update Minor Enemies
      for (let i = minorEnemies.length - 1; i >= 0; i--) {
        const e = minorEnemies[i];
        if (!e || typeof e.update !== 'function') {
          minorEnemies.splice(i, 1);
          continue;
        }
        e.update();

        // Contact damage with player
        if (
          player &&
          e.x + e.w > player.x &&
          e.x < player.x + player.w &&
          e.y + e.h > player.y &&
          e.y < player.y + player.h
        ) {
          player.takeDamage(10);
        }

        // Spell Hits on Minor Enemy
        for (let j = playerProjectiles.length - 1; j >= 0; j--) {
          const proj = playerProjectiles[j];
          if (
            proj.x + proj.w > e.x &&
            proj.x < e.x + e.w &&
            proj.y + proj.h > e.y &&
            proj.y < e.y + e.h
          ) {
            e.hp -= proj.damage;
            createSparkles(e.x, e.y, proj.color, 6);
            playerProjectiles.splice(j, 1);

            if (e.hp <= 0) {
              score += 50;
              levelMinorKills++;
              triggerFloatingText(e.x, e.y, '+50', '#f59e0b');
              minorEnemies.splice(i, 1);

              // Check if boss should spawn
              if (levelMinorKills >= REQUIRED_KILLS_FOR_BOSS) {
                spawnLevelBoss();
              }
              break;
            }
          }
        }
      }

      // Update Boss
      if ((levelState === 'BOSS' || levelState === 'FINAL_DUEL') && boss && typeof boss.update === 'function') {
        boss.update();

        // Player Projectiles hitting Boss
        for (let j = playerProjectiles.length - 1; j >= 0; j--) {
          const proj = playerProjectiles[j];
          if (
            proj.x + proj.w > boss.x &&
            proj.x < boss.x + boss.w &&
            proj.y + proj.h > boss.y &&
            proj.y < boss.y + boss.h
          ) {
            boss.hp -= proj.damage;
            playerProjectiles.splice(j, 1);

            if (currentLevel === 8) {
              // Voldemort Final Duel Logic
              if (proj.isCrit) {
                voldemortCritHits++;
                sound.playCritHit();
                triggerFloatingText(boss.x, boss.y, `CRITICAL HIT! (${voldemortCritHits}/5)`, '#22c55e');
                createSparkles(boss.x, boss.y, '#22c55e', 20);

                if (voldemortCritHits >= 5) {
                  winGame();
                  return;
                }
              } else {
                triggerFloatingText(boss.x, boss.y, 'HIT', '#f59e0b');
              }
            } else {
              triggerFloatingText(boss.x, boss.y, `-${proj.damage}`, '#ef4444');
              createSparkles(boss.x, boss.y, '#f59e0b', 8);

              if (boss.hp <= 0) {
                sound.playBossDefeat();
                score += 500 * currentLevel;
                clearLevelStage();
                return;
              }
            }
          }
        }
      }

      // Update Player Spells
      for (let i = playerProjectiles.length - 1; i >= 0; i--) {
        const p = playerProjectiles[i];
        p.x += p.vx;
        if (p.x < 0 || p.x > V_WIDTH) playerProjectiles.splice(i, 1);
      }

      // Update Enemy Spells
      for (let i = enemyProjectiles.length - 1; i >= 0; i--) {
        const ep = enemyProjectiles[i];
        ep.x += ep.vx;
        ep.y += ep.vy;

        if (
          ep.x + ep.w > player.x &&
          ep.x < player.x + player.w &&
          ep.y + ep.h > player.y &&
          ep.y < player.y + player.h
        ) {
          player.takeDamage(ep.damage);
          enemyProjectiles.splice(i, 1);
          continue;
        }

        if (ep.x < -10 || ep.x > V_WIDTH + 10 || ep.y < -10 || ep.y > V_HEIGHT + 10) {
          enemyProjectiles.splice(i, 1);
        }
      }

      // Update Particles
      for (let i = particles.length - 1; i >= 0; i--) {
        const p = particles[i];
        p.x += p.vx;
        p.y += p.vy;
        p.life -= p.decay;
        if (p.life <= 0) particles.splice(i, 1);
      }

      // Update Floating Text
      for (let i = floatingTexts.length - 1; i >= 0; i--) {
        const ft = floatingTexts[i];
        ft.y += ft.vy;
        ft.life -= 0.02;
        if (ft.life <= 0) floatingTexts.splice(i, 1);
      }
    }

    function spawnLevelBoss() {
      levelState = currentLevel === 8 ? 'FINAL_DUEL' : 'BOSS';
      minorEnemies = [];
      const cfg = LEVEL_CONFIGS[currentLevel];
      boss = new BossEnemy(cfg.bossType);
      triggerFloatingText(V_WIDTH / 2 - 40, 50, `${cfg.bossName.toUpperCase()} APPEARS!`, '#ef4444');
    }

    function clearLevelStage() {
      isPlaying = false;
      document.getElementById('victoryTitle').innerText = `LEVEL ${currentLevel} CLEARED!`;
      document.getElementById('victoryDesc').innerText = `${LEVEL_CONFIGS[currentLevel].bossName} Defeated!`;
      document.getElementById('victoryOverlay').classList.remove('hidden');
    }

    function winGame() {
      isPlaying = false;
      sound.playBossDefeat();

      if (score > highScore) {
        highScore = score;
        localStorage.setItem('hogwarts_pixel_highscore', highScore.toString());
      }

      document.getElementById('winScore').innerText = score;
      document.getElementById('gameCompleteOverlay').classList.remove('hidden');
    }

    function renderGame() {
      ctx.clearRect(0, 0, V_WIDTH, V_HEIGHT);

      renderBackground();

      // Draw Minor Enemies
      minorEnemies.forEach(e => {
        if (e && typeof e.draw === 'function') e.draw();
      });

      // Draw Boss
      if (boss && typeof boss.draw === 'function') boss.draw();

      // Draw Player
      if (player && typeof player.draw === 'function') player.draw();

      // Draw Player Projectiles
      playerProjectiles.forEach(p => {
        ctx.fillStyle = p.color;
        ctx.fillRect(Math.floor(p.x), Math.floor(p.y), p.w, p.h);
      });

      // Draw Enemy Projectiles
      enemyProjectiles.forEach(ep => {
        ctx.fillStyle = ep.color;
        ctx.fillRect(Math.floor(ep.x), Math.floor(ep.y), ep.w, ep.h);
      });

      // Draw Particles
      particles.forEach(p => {
        ctx.save();
        ctx.globalAlpha = Math.max(0, p.life);
        ctx.fillStyle = p.color;
        ctx.fillRect(Math.floor(p.x), Math.floor(p.y), 2, 2);
        ctx.restore();
      });

      // Draw Floating Text
      floatingTexts.forEach(ft => {
        ctx.save();
        ctx.globalAlpha = Math.max(0, ft.life);
        ctx.font = '6px "Press Start 2P"';
        ctx.fillStyle = ft.color;
        ctx.fillText(ft.text, Math.floor(ft.x), Math.floor(ft.y));
        ctx.restore();
      });

      drawHUD();
    }

    function resetLevel(levelNum) {
      currentLevel = levelNum;
      levelState = currentLevel === 8 ? 'FINAL_DUEL' : 'MINORS';
      levelMinorKills = 0;
      minorEnemies = [];
      boss = null;
      playerProjectiles = [];
      enemyProjectiles = [];
      particles = [];
      floatingTexts = [];
      
      buildLevelPlatforms(currentLevel);
      player = new WizardPlayer(chosenChar);

      if (currentLevel === 8) {
        voldemortCritHits = 0;
        spawnLevelBoss();
      }
    }

    function startGame() {
      sound.init();
      score = 0;
      resetLevel(1);
      isPlaying = true;
      isPaused = false;

      document.getElementById('startOverlay').classList.add('hidden');
      document.getElementById('gameOverOverlay').classList.add('hidden');
      document.getElementById('victoryOverlay').classList.add('hidden');
      document.getElementById('gameCompleteOverlay').classList.add('hidden');
      document.getElementById('pauseOverlay').classList.add('hidden');
    }

    function gameOver() {
      isPlaying = false;
      sound.playHurt();

      if (score > highScore) {
        highScore = score;
        localStorage.setItem('hogwarts_pixel_highscore', highScore.toString());
      }

      document.getElementById('finalScore').innerText = score;
      document.getElementById('finalLevel').innerText = currentLevel;
      document.getElementById('bestScore').innerText = highScore;
      document.getElementById('startHighScore').innerText = highScore;

      document.getElementById('gameOverOverlay').classList.remove('hidden');
    }

    function resizeCanvas() {
      const container = canvas.parentElement;
      const rect = container.getBoundingClientRect();

      const targetAspect = V_WIDTH / V_HEIGHT;
      let width = rect.width;
      let height = rect.height;

      if (width / height > targetAspect) {
        width = height * targetAspect;
      } else {
        height = width / targetAspect;
      }

      canvas.width = V_WIDTH;
      canvas.height = V_HEIGHT;
      canvas.style.width = `${Math.floor(width)}px`;
      canvas.style.height = `${Math.floor(height)}px`;
    }

    window.addEventListener('resize', resizeCanvas);
    resizeCanvas();

    function gameLoop() {
      updateGame();
      renderGame();
      requestAnimationFrame(gameLoop);
    }

    window.addEventListener('keydown', (e) => {
      if (e.code === 'ArrowLeft' || e.code === 'KeyA') keys.left = true;
      if (e.code === 'ArrowRight' || e.code === 'KeyD') keys.right = true;
      if (e.code === 'Space' || e.code === 'ArrowUp' || e.code === 'KeyW') keys.jump = true;
      if (e.code === 'KeyJ' || e.code === 'KeyZ') keys.cast = true;
      if (e.code === 'KeyK' || e.code === 'KeyX') keys.special = true;
      if (e.code === 'KeyP' && isPlaying) togglePause();
    });

    window.addEventListener('keyup', (e) => {
      if (e.code === 'ArrowLeft' || e.code === 'KeyA') keys.left = false;
      if (e.code === 'ArrowRight' || e.code === 'KeyD') keys.right = false;
      if (e.code === 'Space' || e.code === 'ArrowUp' || e.code === 'KeyW') keys.jump = false;
      if (e.code === 'KeyJ' || e.code === 'KeyZ') keys.cast = false;
      if (e.code === 'KeyK' || e.code === 'KeyX') keys.special = false;
    });

    // Mobile / Touch controls
    const bindTouchBtn = (elem, keyName) => {
      elem.addEventListener('touchstart', (e) => { e.preventDefault(); keys[keyName] = true; });
      elem.addEventListener('touchend', (e) => { e.preventDefault(); keys[keyName] = false; });
      elem.addEventListener('mousedown', () => { keys[keyName] = true; });
      elem.addEventListener('mouseup', () => { keys[keyName] = false; });
    };

    bindTouchBtn(document.getElementById('btnLeft'), 'left');
    bindTouchBtn(document.getElementById('btnRight'), 'right');
    bindTouchBtn(document.getElementById('btnJump'), 'jump');
    bindTouchBtn(document.getElementById('btnCast'), 'cast');
    bindTouchBtn(document.getElementById('btnSpecial'), 'special');

    // UI Character Select Buttons
    const selectChar = (char, elementId) => {
      chosenChar = char;
      document.querySelectorAll('.char-card').forEach(el => {
        el.classList.remove('border-4', 'border-amber-400');
        el.classList.add('border-2', 'border-amber-700/60');
      });
      const selected = document.getElementById(elementId);
      selected.classList.remove('border-2', 'border-amber-700/60');
      selected.classList.add('border-4', 'border-amber-400');
    };

    document.getElementById('charHarry').addEventListener('click', () => selectChar('harry', 'charHarry'));
    document.getElementById('charHermione').addEventListener('click', () => selectChar('hermione', 'charHermione'));
    document.getElementById('charRon').addEventListener('click', () => selectChar('ron', 'charRon'));

    // Modal Action Buttons
    document.getElementById('startBtn').addEventListener('click', startGame);
    document.getElementById('retryBtn').addEventListener('click', startGame);
    document.getElementById('playAgainWinBtn').addEventListener('click', startGame);

    document.getElementById('nextLevelBtn').addEventListener('click', () => {
      document.getElementById('victoryOverlay').classList.add('hidden');
      resetLevel(currentLevel + 1);
      isPlaying = true;
    });
