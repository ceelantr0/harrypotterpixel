<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Hogwarts Pixel Quest - Wizard's Duel</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-dark: #0a0612;
      --gold-accent: #f59e0b;
      --gryffindor-red: #800020;
      --magic-cyan: #06b6d4;
    }

    * {
      user-select: none;
      -webkit-user-select: none;
      touch-action: manipulation;
      box-sizing: border-box;
    }

    body {
      font-family: 'Press Start 2P', monospace;
      background-color: var(--bg-dark);
      color: #ffffff;
      overflow: hidden;
    }

    /* Crisp pixelated rendering for 8-bit retro art */
    canvas {
      image-rendering: pixelated;
      image-rendering: crisp-edges;
      box-shadow: 0 0 35px rgba(245, 158, 11, 0.25);
    }

    .pixel-box {
      border: 4px solid #f59e0b;
      box-shadow: 4px 4px 0px #000, -4px -4px 0px #381022;
      background: rgba(20, 10, 35, 0.95);
    }

    .pixel-btn {
      position: relative;
      border: 4px solid #000;
      background: #800020;
      color: #fff;
      box-shadow: inset -4px -4px 0px #400010, inset 4px 4px 0px #b3002d, 4px 4px 0px #000;
      transition: transform 0.05s, background-color 0.1s;
      cursor: pointer;
    }

    .pixel-btn:active {
      transform: translate(2px, 2px);
      box-shadow: inset -2px -2px 0px #400010, inset 2px 2px 0px #b3002d, 2px 2px 0px #000;
    }

    .pixel-btn-gold {
      background: #d97706;
      color: #fff;
      box-shadow: inset -4px -4px 0px #92400e, inset 4px 4px 0px #f59e0b, 4px 4px 0px #000;
    }

    .pixel-btn-blue {
      background: #1d4ed8;
      color: #fff;
      box-shadow: inset -4px -4px 0px #1e3a8a, inset 4px 4px 0px #3b82f6, 4px 4px 0px #000;
    }

    .pixel-btn-green {
      background: #15803d;
      color: #fff;
      box-shadow: inset -4px -4px 0px #14532d, inset 4px 4px 0px #22c55e, 4px 4px 0px #000;
    }

    .pixel-btn-red {
      background: #b91c1c;
      color: #fff;
      box-shadow: inset -4px -4px 0px #7f1d1d, inset 4px 4px 0px #ef4444, 4px 4px 0px #000;
    }

    /* Pulse animation for retro text */
    @keyframes titleGlow {
      0%, 100% { text-shadow: 0 0 8px #f59e0b, 0 0 16px #ef4444; }
      50% { text-shadow: 0 0 16px #3b82f6, 0 0 24px #10b981; }
    }

    .wizard-title {
      animation: titleGlow 2.5s infinite ease-in-out;
    }

    /* CRT Arcade overlay effect */
    .scanlines {
      background: linear-gradient(
        rgba(18, 16, 16, 0) 50%, 
        rgba(0, 0, 0, 0.35) 50%
      );
      background-size: 100% 4px;
      pointer-events: none;
    }
  </style>
</head>
<body class="h-screen w-screen flex flex-col items-center justify-center p-2 sm:p-4 select-none">

  <div class="relative flex flex-col items-center justify-center w-full max-w-3xl h-full max-h-[900px]">
    
    <!-- Top HUD Header -->
    <header class="w-full flex items-center justify-between px-3 py-2 mb-2 pixel-box">
      <div class="flex items-center space-x-2">
